# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Gemini SANDBOX API key (https://exchange.sandbox.gemini.com/settings/api)
# Scope: account (key starts with "account-"). Role: Trader only.
# "Uses a time-based nonce": on. "Requires Heartbeat": off.
GEMINI_ENV=sandbox
GEMINI_API_KEY=
GEMINI_API_SECRET=

# Privy development app (https://dashboard.privy.io) - needed from slice S2
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_TEST_EMAIL=
PRIVY_TEST_OTP=

# Solana devnet (public endpoints work; a provider key is optional)
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
