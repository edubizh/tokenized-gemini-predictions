# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Gemini SANDBOX API key (https://exchange.sandbox.gemini.com/settings/api).
# Scope: account (the key starts with "account-"). Role: Trader only.
# "Uses a time-based nonce": on. "Requires Heartbeat": off.
# Not needed when the relayer runs with the simulated venue (pnpm dev:mock).
GEMINI_ENV=sandbox
GEMINI_API_KEY=
GEMINI_API_SECRET=

# Privy development app (https://dashboard.privy.io) with email and Solana wallet login enabled.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Optional: a Privy test account, used only by the browser checks in apps/web/e2e.
PRIVY_TEST_EMAIL=
PRIVY_TEST_OTP=

# Solana devnet. The web app accepts only this endpoint (or a local validator with CLUSTER=localnet).
SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional settings and their defaults:
# CLUSTER=devnet                                  devnet or localnet
# VENUE=sandbox                                   sandbox or mock
# MARKET_SERIES=BTC15M,ETH15M,SOL15M,XRP15M       the series the relayer offers
# RELAYER_PORT=8787                               the relayer's local API
# RELAYER_URL=http://127.0.0.1:8787               where the web app finds the relayer
